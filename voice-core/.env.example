# WAMO Voice-Core: alle Einstellungen, die der Code liest. Keine Werte committen.
# Der Voice-Core lädt die .env im Hauptordner (oder hier in voice-core/).
# Leere Zeilen bedeuten: Standard aus dem Code (steht im Kommentar).

# --- Pflicht für Gespräche ---
# Spracherkennung und Sprachausgabe
SONIOX_API_KEY=
# Sprachmodell, Websuche, Bildschirm-Auswertung und Lernen
ANTHROPIC_API_KEY=
# Nur bei Organisationsschluesseln ohne Workspace-Bindung: ID des Workspace (wrkspc_...)
ANTHROPIC_WORKSPACE_ID=

# --- Modelle ---
# Gesprächsmodell (Standard claude-haiku-5-5)
CLAUDE_MODEL_FAST=
# Modell für die Websuche (Standard claude-haiku-5-5)
SEARCH_MODEL=
# Bildmodell für bildschirm_ansehen und auf_bildschirm_klicken (Standard claude-sonnet-5-5)
VISION_MODEL=

# --- Eigene Modelle über LiteLLM (Ausbaustufe P4, llm_anbieter.py) ---
# Nur über das Gateway, nie direkt an die Adressen der Sparks.
LITELLM_BASE_URL=
LITELLM_API_KEY=
# Anbieter je Baustein: claude (Standard) oder litellm. Das Modell ist bei litellm ein Alias des Gateways
# (Liste: uv run python eval/abnahme.py --liste), bei claude eine Claude-ID (Standard siehe oben).
# Gespräch
WAMO_LLM_ANBIETER=
WAMO_LLM_MODELL=
# Lernen aus dem Gespräch
WAMO_LLM_LERNEN=
WAMO_LLM_LERNEN_MODELL=
# Bildschirm ansehen und klicken (braucht ein Bildmodell)
WAMO_LLM_VISION=
WAMO_LLM_VISION_MODELL=
# Zusammenfassung langer Gespräche; leer: mit dem Gesprächsmodell
WAMO_LLM_ZUSAMMENFASSUNG=
WAMO_LLM_ZUSAMMENFASSUNG_MODELL=
# Ist LiteLLM nicht nutzbar (Schlüssel, Gateway, Modell): leer oder claude (Standard, alle Bausteine) wechselt
# mit Fehlermeldung zu Claude, aus bricht stattdessen ab (dann geht für den Baustein nichts an Claude), eine
# Liste wie gespraech,zusammenfassung erlaubt den Rückfall nur dort. Die Sprache läuft weiter über Soniox.
WAMO_LLM_RUECKFALL=
# Zusätzliche Parameter je LiteLLM-Anfrage als JSON-Objekt, z. B. {"reasoning_effort": "none"}. Was das
# OpenAI-SDK nicht kennt, geht als extra_body mit, z. B. {"chat_template_kwargs": {"enable_thinking": false}}.
WAMO_LLM_EXTRA=

# --- Hören und Stimme im Haus (sprache_anbieter.py, Paket H5) ---
# Soniox bleibt Standard. Jede Person wählt in der Oberfläche (Einstellungen, Modellzugang) "Im Haus"; Laborsitzungen
# hören immer über Soniox. Ohne Modell, Stimme oder Gateway fällt der Baustein mit Grund auf Soniox zurück.
# Modell des Gateways für Spracherkennung (/audio/transcriptions), z. B. wamo-stt-haus
WAMO_STT_HAUS_MODELL=
# Modell des Gateways für Sprachausgabe (/audio/speech), z. B. wamo-tts-haus, und seine Stimme (Qwen3-TTS: z. B. sohee)
WAMO_TTS_HAUS_MODELL=
WAMO_TTS_HAUS_STIMME=
# an: Sprachausgabe gestreamt über die Durchreiche /<modell>/v1/audio/speech des Gateways (erstes Audio rund 0,14 s statt
# der ganzen Satzdauer); nur setzen, wenn die Durchreiche im Gateway eingerichtet ist. Standard aus. Nur vom Server.
WAMO_TTS_HAUS_STREAM=
# Übersteuerung für alle Sitzungen dieses Kerns: soniox oder haus; leer heißt die Wahl des Profils
WAMO_STT_ANBIETER=
WAMO_TTS_ANBIETER=

# --- Websuche ---
# anthropic (Standard, Claude-Websuche) oder searxng (eigene Instanz, Ergebnisse gekürzt und als Daten markiert)
WAMO_SUCHE=
# Adresse von SearXNG, z. B. http://192.168.178.64:8080 (caesar). Pflicht bei WAMO_SUCHE=searxng: fehlt sie,
# schlägt die Suche fehl, statt still die Cloud-Suche zu nehmen.
WAMO_SEARXNG_URL=

# --- Soniox ---
# Endpunkte (Standard: EU-Spracherkennung und Soniox-Sprachausgabe)
SONIOX_STT_URL=
SONIOX_TTS_URL=
# Stimme aus der Bibliothek oder UUID einer eigenen Stimme (Standard Bryce)
SONIOX_VOICE=
# Fachbegriffe für die Spracherkennung, kommagetrennt. Ohne Eintrag gilt die Liste in bot.py,
# ein leerer Wert schaltet sie ab.
# SONIOX_TERMS=Wais, W.A.I.S., WAMO, WAMOCON, Eschborn, VS Code

# --- Gesprächsverhalten ---
# Wörter ohne Rückmeldelaute, ab denen WAMO unterbrochen wird ("Doch" reicht, "mhm" nicht)
MIN_INTERRUPT_WORDS=1
# Begrüßung beim Verbinden, {name} wird durch den Profilnamen ersetzt; leer schaltet sie ab
# (Standard: Hallo {name}, Wais ist bereit.) Den Namen als Wais schreiben, nie W.A.I.S.: die Sprachausgabe spricht
# ihn über aussprache.py richtig aus.
# WAMO_GREETING=Hallo {name}, Wais ist bereit.
# Kanal, der in der Sitzung gespeichert wird (Standard web)
WAMO_CHANNEL=
# Nach so vielen neuen Sätzen lernt WAMO im laufenden Gespräch (Standard 4)
LEARN_EVERY_USER_TURNS=
# Zusammenfassung langer Gespräche ab so vielen Tokens, Ziel danach (Standard 60000 und 25000)
SUMMARY_TRIGGER_TOKENS=
SUMMARY_TARGET_TOKENS=
# Satzende-Erkennung in Sekunden (Standard 1.0, 1.5 und 3.0)
SMART_TURN_STOP_SECS=
TURN_INCOMPLETE_SHORT_SECS=
TURN_INCOMPLETE_LONG_SECS=
# Weiche Unterbrechung: höchstens so viele Wörter nach einem Einwurf, Ton-Verzug in Sekunden
# (Standard 3 und 0.5)
SOFT_INTERRUPT_MAX_WORDS=
SOFT_INTERRUPT_LAG_SECS=
# Innehalten statt Abbrechen: ein einzelnes Wort der Person lässt WAMO an der Wortgrenze innehalten (WAMO_INNEHALTEN, Standard an),
# nach so viel Stille spricht WAMO weiter (Standard 0.7), höchstens so lange hält WAMO inne (Standard 2.5, höchstens 3.5)
WAMO_INNEHALTEN=
WAMO_INNEHALTEN_WEITER_SECS=
WAMO_INNEHALTEN_MAX_SECS=

# --- Ort und Zeit ---
# Ort für die Websuche (Standard Eschborn) und Zeitzone (Standard Europe/Berlin)
WAMO_CITY=
WAMO_TIMEZONE=

# --- Anmeldung (Supabase-Stack supabase-wamo auf Sokrates-2) ---
# HTTPS über wamo-caddy; GoTrue stellt Tokens mit iss = SUPABASE_URL/auth/v1 aus.
# Nur https:// (http:// nur über Loopback), sonst lehnt der Voice-Core jede Anmeldung ab.
SUPABASE_URL=https://192.168.178.136:55443
# Öffentliches Root-Zertifikat der WAMO-CA (absoluter Pfad zu infra/sokrates2/wamo-ca.crt). Gilt nur für
# Verbindungen zum WAMO-Stack (JWKS, GoTrue, Postgres), nicht für Claude, Soniox oder die Websuche.
# Gesetzt, aber unlesbar: Start bricht ab bzw. Datenbank gilt als nicht erreichbar.
WAMO_CA_FILE=
# Öffentlicher Publishable Key (sb_publishable_...) für den HS256-Rückfall der Token-Prüfung und als apikey beim Wechsel des
# Startpassworts (erstanmeldung_api.py); ohne ihn antwortet POST /wamo/api/erstanmeldung/passwort mit 503
SUPABASE_PUBLISHABLE_KEY=
# Wohin der Kern den Wechsel des Startpassworts schickt (PUT <Adresse>/auth/v1/user, am Caddy vorbei, der das sperrt).
# Leer heißt http://127.0.0.1:55321 (Envoy des Stacks). Erlaubt: http nur mit 127.0.0.1, ::1 oder localhost, sonst https
WAMO_GOTRUE_INTERN_URL=
# Nur setzen, wenn der Aussteller (iss) der Tokens nicht SUPABASE_URL/auth/v1 ist
WAMO_AUTH_ISSUER=
# Von welchen Seiten Sitzungen starten dürfen, kommagetrennt
# (Standard http://localhost:3000,http://127.0.0.1:3000)
PIPECAT_ALLOWED_ORIGINS=

# --- Datenbank (Gedächtnis und Profile) ---
# Postgres als Rolle wamo_core über Supavisor (Port 55322, Benutzer wamo_core.wamo), mit TLS:
# ...@192.168.178.136:55322/postgres?sslmode=verify-full (Prüfung gegen WAMO_CA_FILE). Mit WAMO_CA_FILE gilt
# ohne sslmode verify-full; disable, allow, prefer oder require sperren die Datenbank (Konfigurationsfehler).
# Ohne Eintrag: Gedächtnis aus und Anmeldung gesperrt.
WAMO_DATABASE_URL=
# Verwaltung (nur wamo_admin.py): Postgres als Rolle wamo_admin. Darf Profile anlegen und
# gemeinsame Vorschläge freigeben; der Voice-Core nutzt diese Verbindung nie.
WAMO_ADMIN_DATABASE_URL=
# wamo_dev, wamo_test oder wamo_prod (Standard wamo_dev)
WAMO_DB_SCHEMA=

# --- Sitzungen und Protokoll ---
# Höchstdauer einer Sitzung in Minuten (Standard 120); das Profil wird jede Minute neu geprüft
WAMO_MAX_SITZUNG_MIN=
# Eine Sitzung je Profil (sitzungen.py): eine neue Sitzung desselben Profils löst die laufende ab, die PC-Sperre geht
# auf die neue über. Standard an; aus, off, 0, false oder nein schalten ab. Andere Profile bleiben unberührt.
WAMO_SITZUNG_EINZELN=
# Höchstalter der Anmeldung in Stunden, gemessen ab Passwort und Code (Claim amr im Token, auth_gate.py). Standard 168
# (7 Tage), erlaubt mehr als 0 und höchstens 720. Tokens ohne amr werden abgelehnt; eine laufende Sitzung endet beim
# Überschreiten mit einer Meldung, die Oberfläche meldet dann ab.
WAMO_ANMELDUNG_MAX_STUNDEN=
# Lange Werkzeugausgaben werden ab so vielen Zeichen gekürzt, bevor sie in den Kontext des Sprachmodells gehen; das Original
# bleibt nur im Arbeitsspeicher der Sitzung (Werkzeug ausgabe_nachladen). Standard 3000, 0 schaltet das Kürzen ganz ab.
WAMO_AUSGABE_SCHWELLE=
# Stimmabdruck (stimme_gate.py): jedes Profil kann seine Stimme einlernen (Oberfläche, mit Einwilligung); wirkt nur für Profile mit
# Abdruck, nie für Laborprofile. Modus: aus, beobachten (Standard seit 18.11.2026: messen und anzeigen, nichts sperren) oder streng (nur
# auf ausdrücklichen Wunsch: nur die eigene Stimme geht ans Sprachmodell, Werkzeuge außer Uhrzeit, Websuche und Canvas sind bei unsicherer
# Stimme gesperrt).
WAMO_STIMME_PRUEFUNG=
# Schwellen (Kosinus der Stimmabdrücke, seit 17.11.2026 nach Länge): die eigene Stimme ab EIGEN_MIN_KURZ (Standard 0,35) bis 1,5 s Sprache
# und ab EIGEN_MIN_LANG (Standard 0,45) ab 3 s, dazwischen linear (beide 0,35 bis 0,95, kurz nie über lang); eine persönliche Schwelle vom
# Einlernen (Migration 0025) ersetzt die kurze. EIGEN_MIN ist der alte Schalter für beide Längen: er gilt nur, wo KURZ oder LANG leer sind,
# also leer lassen, sonst gibt es keine Staffel. Bis FREMD_MAX (Standard 0,3, für alle Längen) fremd; MIN_SECS (Standard 1): so viel reine
# Sprache braucht eine Äußerung für ein Urteil; VERTRAUEN_SECS (Standard 120): so lange gilt "eigen" für Folgesätze;
# KURZ_VERTRAUEN_SECS (Standard 15): so lange höchstens, wenn seit der letzten sicheren Erkennung nur kurze Äußerungen kamen;
# KURZ_ERBEN_SECS (Standard 60, 0 aus): eine Äußerung unter MIN_SECS erbt das Urteil eigen bis so lange nach der letzten sicheren
# Erkennung, nie während W.A.I.S. spricht
WAMO_STIMME_KURZ_ERBEN_SECS=
WAMO_STIMME_EIGEN_MIN_KURZ=
WAMO_STIMME_EIGEN_MIN_LANG=
WAMO_STIMME_EIGEN_MIN=
WAMO_STIMME_FREMD_MAX=
WAMO_STIMME_MIN_SECS=
WAMO_STIMME_VERTRAUEN_SECS=
WAMO_STIMME_KURZ_VERTRAUEN_SECS=
# Nur die eigene Stimme (stimme_waechter.py, seit 17.11.2026, Modus streng mit Abdruck): NUR_EIGEN (an oder aus, Standard an) lässt nur
# eine eigene Äußerung ans Modell, alles andere wird verworfen; UNTERBRECHEN_NUR_EIGEN (an oder aus, Standard an): während W.A.I.S.
# spricht, unterbricht nur die eigene Stimme, erst nach dem Urteil eigen (rund 0,5 bis 1 Sekunde später als ohne). aus: wie vorher
WAMO_STIMME_NUR_EIGEN=
WAMO_STIMME_UNTERBRECHEN_NUR_EIGEN=
# Nur mit WAMO_STIMME_NUR_EIGEN=aus (Regel vom 16.11.2026): fremde Äußerungen immer verwerfen, unklare unter VERWERFEN_MAX (Standard 0,4,
# an den Bereich FREMD_MAX bis EIGEN_MIN_LANG gesetzt, 0 schaltet es ab); VERWERFEN_MIN_SECS (Standard 0): so viel reine Sprache braucht eine
# Äußerung mindestens, damit sie verworfen wird
WAMO_STIMME_VERWERFEN_MAX=
WAMO_STIMME_VERWERFEN_MIN_SECS=
# Modelldatei (NeMo TitaNet-Large, ONNX, rund 100 MB). Standard: Cache-Ordner des Dienstes (XDG_CACHE_HOME/wamo/sprecher/), sonst
# voice-core/.cache/sprecher/. Der Kern lädt sie beim ersten Bedarf nach und prüft die SHA-256-Summe; am Server vorab ablegen (README).
WAMO_STIMME_MODELL=
# Zweites Sprechermodell im Schattenbetrieb (stimme_schatten.py, Standard aus): an lädt WeSpeaker ResNet34 zusätzlich (Cache-Ordner,
# SHA-256 geprüft), lernt beim Einlernen einen zweiten Abdruck mit (Migration 0028) und schreibt je Äußerung eine Zeile mit Zahlen ins
# Log (Stimmschatten:, auswerten mit scripts/wamo_stimme_schatten_auswerten.py). Das Urteil bleibt bei TitaNet. Am Server nur über wamo-core-env.
WAMO_STIMME_SCHATTEN=
# Log-Stufe (Standard INFO). INFO enthält keine Gesprächsinhalte, DEBUG schon.
WAMO_LOG_LEVEL=

# --- PC-Host und Entwicklungsaufträge (nur Rolle admin) ---
# off schaltet die PC-Werkzeuge ganz ab (Standard on). Auch eingerichtet sind sie je Sitzung erst
# aus und werden in der Oberfläche eingeschaltet.
WAMO_PC_HOST=
# Nur Büro (Kern auf Sokrates-2, /etc/wamo/core.env): zweites Geheimnis neben WAMO_PC_HOST_TOKEN für Freigaben
# kritischer PC-Aktionen (pc_freigaben.py). Am PC liegt es in %LOCALAPPDATA%\WAMO\host-freigabe; übertragen mit
# python scripts\wamo_kern_sokrates2.py token. Fehlt es, lässt sich im Büro nichts freigeben. Lokal (stdio) erzeugt
# der Kern es je Host-Start selbst; dann leer lassen.
WAMO_PC_HOST_FREIGABE=
# Entwicklungsaufträge an Claude Code: an oder aus (Standard aus)
WAMO_ENTWICKLUNG=
# Ort der Aufträge: sokrates2 (Standard, bubblewrap-Sandbox als Benutzer wamo) oder lokal
# (nur ausdrücklich, ohne Abschottung, mit Warnung im Log)
WAMO_ENTWICKLUNG_ORT=
# SSH-Ziel (Standard wamo@192.168.178.136) und Schlüssel (Standard ~/.ssh/id_ed25519_wamo_jobs) für den Dispatcher
WAMO_ENTWICKLUNG_SSH_ZIEL=
WAMO_ENTWICKLUNG_SSH_SCHLUESSEL=
# Claude-Zugang der Aufträge: jedes Profil nutzt seinen eigenen (Max-Token oder API-Schlüssel, Karte Modellzugang).
# Nur das hier genannte Profil (UUID) darf ohne eigenen Zugang den Zugang aus /etc/wamo/geheim.env nutzen; leer = das
# Profil aus WAMO_CLAUDE_SCHLUESSEL_PROFIL. Für alle anderen startet ohne eigenen Zugang kein Auftrag.
WAMO_ENTWICKLUNG_SERVERZUGANG_PROFIL=
# Nur lokal: Ordner für Projekte von Claude Code (Standard: Benutzerordner/Projekte). Darf das WAMO-Repo
# weder enthalten noch darin liegen.
WAMO_PROJECTS_DIR=
# Befehlskriterien der Abnahme („befehl: pytest -q“): nur bei WAMO_ENTWICKLUNG_ORT=lokal und nur mit dem Wert ja (Standard
# aus). Dabei läuft Projektcode (conftest, Makefile, Tests) ohne Hook und ohne Sandbox mit den Rechten des Kerns. Aus: das
# Modell formuliert stattdessen Aussagen, die ein kleines Modell beurteilt. Nicht auf Sokrates-2 (dort gibt es keinen Ausführer).
WAMO_ABNAHME_BEFEHLE=
# Prüfbares Ziel: WAMO leitet für Entwicklungsaufträge selbst ein bis drei messbare Kriterien ab und nennt sie in einem Satz,
# der Auftrag läuft dann in Runden (Standard an, leer = an; aus, 0, nein oder off bringen den früheren Prompt zurück).
WAMO_PERSONA_ABNAHME=
# Büro (Kern auf Sokrates-2, WAMO_BETRIEB=buero): Entwicklungsaufträge laufen dort nur über den Kern-Kanal des Dispatchers.
# Diese Werte gehören NICHT in die .env. Sie stehen im Drop-in /etc/systemd/system/wamo-core@.service.d/wamo-entwicklung-buero.conf
# auf Sokrates-2, das nur „wamo-job-kern-einrichten.sh schalter an <release> --profil <user_id>“ schreibt (infra/sokrates2/README.md).
# WAMO_ENTWICKLUNG bleibt dort aus und zählt im Büro nicht. Fehlt eine Variable oder ist sie ungültig, bleiben die Aufträge im Büro
# aus. Platzhalter zur Orientierung (auskommentiert; die Kern-Umgebung auf Sokrates-2 übernimmt kein WAMO_ENTWICKLUNG*):
# WAMO_ENTWICKLUNG_BUERO=aus
# WAMO_ENTWICKLUNG_ORT=sokrates2
# WAMO_ENTWICKLUNG_PROFILE=<user_id des Admins, mehrere durch Komma getrennt>
# WAMO_ENTWICKLUNG_KOSTEN_AUFTRAG_USD=<Grenze je Auftrag in USD, Punkt als Dezimaltrenner, zum Beispiel 3>
# WAMO_ENTWICKLUNG_KOSTEN_TAG_USD=<Grenze je Tag und Profil in USD, zum Beispiel 10>
# WAMO_ENTWICKLUNG_BEFEHLE_BUERO=aus
# Zeitlimit je Entwicklungsauftrag in Sekunden (Standard 1800)
DEV_JOB_TIMEOUT_SECS=
# Claude Code erbt nur eine feste Liste von Umgebungsvariablen (PATH, Benutzerordner, ...).
# Weitere Namen hier kommagetrennt freigeben, z. B. GH_TOKEN, wenn gh kein Keyring nutzt.
WAMO_JOB_ENV_PASSTHROUGH=
# Projekt- und Job-Ordner bekommt der Wächter (dev_guard.py) als Argument, nicht über die Umgebung.

# --- Jira-Stories aus dem Canvas (nur Rolle admin, nur im Büro; jira_werkzeuge.py) ---
# Auf Sokrates-2 setzt diese Werte nur "wamo-core-env setzen" per stdin (docs/jira-benutzer-einrichten.md); sie kommen nie aus dieser
# Datei auf den Server. Leer heißt aus. WAMO_JIRA_TOKEN ist das API-Token eines eigenen technischen Jira-Benutzers nur für W.A.I.S.
# (Rechte Browse Projects und Create Issues), nie das Token einer Person und nie der Lese-Zugang der Entwicklungsaufträge.
WAMO_JIRA=
WAMO_JIRA_URL=
WAMO_JIRA_EMAIL=
WAMO_JIRA_TOKEN=
WAMO_JIRA_PROJEKTE=
WAMO_JIRA_STANDARD_PROJEKT=

# --- Werkstatt: Karten des Testlabors im Betrieb nachladen (labor_karten_db.py, nur Laborsitzungen) ---
# Auf Sokrates-2 setzt diesen Wert nur "wamo-core-env setzen" per stdin; er kommt nie aus dieser Datei auf den Server. Leer oder aus heißt:
# der Kern liest nichts aus der Datenbank nach und verhält sich wie vorher. an: höchstens alle 30 Sekunden je Prozess werden die zwei Ansichten
# labor_karten_aktive_version und labor_wissen_aktiv gelesen (nur select), die Wissenstexte der veröffentlichten Karten stehen als Daten im
# Abschnitt "Wissen aus dem Katalog" der Laborsitzung.
WAMO_LABOR_KARTEN_NACHLADEN=
