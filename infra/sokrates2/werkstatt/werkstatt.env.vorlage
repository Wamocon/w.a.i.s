# W.A.I.S. Werkstatt: Einstellungen ohne Geheimnisse (root:root 0644). Entsteht beim Einrichten aus dieser Vorlage, nur wenn die Datei fehlt; eine vorhandene bleibt
# unverändert. Der Zugang zur Datenbank steht nie hier, sondern in db.zugang (root:wamo-werkstatt 0440, scripts/wamo_dienst_db.py einrichten werkstatt).
# Nach einer Änderung:  sudo systemctl restart wamo-werkstatt
WAMO_WERKSTATT_HOST=127.0.0.1
WAMO_WERKSTATT_PORT=18095
WAMO_WERKSTATT_SCHEMA=__SCHEMA__
WAMO_WERKSTATT_ADMINS=/etc/wamo-werkstatt/admins
WAMO_WERKSTATT_DATEN=/var/lib/wamo-werkstatt
WAMO_WERKSTATT_CA=/etc/wamo-werkstatt/wamo-ca.crt
WAMO_WERKSTATT_JWKS_URL=https://192.168.178.136:55443/auth/v1/.well-known/jwks.json
WAMO_WERKSTATT_ISS=https://192.168.178.136:55443/auth/v1
WAMO_WERKSTATT_AUD=authenticated
WAMO_WERKSTATT_HERKUNFT=https://192.168.178.136:55445
WAMO_WERKSTATT_WISSEN_BASIS=4120
